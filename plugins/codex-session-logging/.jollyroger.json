{
  "schema_version": 1,
  "id": "codex-session-logging",
  "version": "0.2.24",
  "owner": "Core Edge",
  "providers": [
    "codex",
    "claude"
  ],
  "runtime": {
    "python_min": "3.11"
  },
  "include": [
    "scripts/session_logging.py",
    "scripts/rollout_sync.py",
    "scripts/rollout_usage.py",
    "scripts/publish_presence.py",
    "scripts/drain_queue.py",
    "scripts/collective.py",
    "scripts/collective_feedback.py",
    "scripts/sesh_context.py",
    "scripts/session_start.py",
    "scripts/user_prompt_submit.py",
    "scripts/pre_tool_use.py",
    "scripts/post_tool_use.py",
    "scripts/stop.py",
    "skills/search-coding-sessions"
  ],
  "hooks": [
    {
      "id": "forum-guidance",
      "event": "SessionStart",
      "providers": [
        "codex",
        "claude"
      ],
      "entrypoint": "scripts/collective_feedback.py",
      "invocation": {
        "kind": "python-function",
        "function": "feedback_context",
        "kwargs": {
          "event_name": "event",
          "agent": "provider"
        },
        "output": "context"
      },
      "timeout_seconds": 2,
      "failure_policy": "continue",
      "background_work": {
        "mode": "none"
      }
    },
    {
      "id": "sesh-guidance",
      "event": "SessionStart",
      "providers": [
        "codex",
        "claude"
      ],
      "entrypoint": "scripts/sesh_context.py",
      "invocation": {
        "kind": "python-function",
        "function": "sesh_context",
        "kwargs": {},
        "output": "context"
      },
      "timeout_seconds": 2,
      "failure_policy": "continue",
      "background_work": {
        "mode": "none"
      }
    },
    {
      "id": "native-session-start",
      "event": "SessionStart",
      "providers": [
        "codex"
      ],
      "entrypoint": "scripts/session_start.py",
      "invocation": {
        "kind": "python-script",
        "args": [],
        "output": "context"
      },
      "timeout_seconds": 10,
      "failure_policy": "continue",
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing capture and detached upload; native SessionStart also emits guidance, so never select it alongside the function guidance hooks. Activation requires separate worker/state proof."
      }
    },
    {
      "id": "native-user-prompt-submit",
      "event": "UserPromptSubmit",
      "providers": [
        "codex"
      ],
      "entrypoint": "scripts/user_prompt_submit.py",
      "invocation": {
        "kind": "python-script",
        "args": [],
        "output": "ignore"
      },
      "timeout_seconds": 10,
      "failure_policy": "continue",
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing capture and detached upload; native SessionStart also emits guidance, so never select it alongside the function guidance hooks. Activation requires separate worker/state proof."
      }
    },
    {
      "id": "native-pre-tool-use",
      "event": "PreToolUse",
      "providers": [
        "codex"
      ],
      "entrypoint": "scripts/pre_tool_use.py",
      "invocation": {
        "kind": "python-script",
        "args": [],
        "output": "ignore"
      },
      "timeout_seconds": 10,
      "failure_policy": "continue",
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing capture and detached upload; native SessionStart also emits guidance, so never select it alongside the function guidance hooks. Activation requires separate worker/state proof."
      }
    },
    {
      "id": "native-post-tool-use",
      "event": "PostToolUse",
      "providers": [
        "codex"
      ],
      "entrypoint": "scripts/post_tool_use.py",
      "invocation": {
        "kind": "python-script",
        "args": [],
        "output": "ignore"
      },
      "timeout_seconds": 10,
      "failure_policy": "continue",
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing capture and detached upload; native SessionStart also emits guidance, so never select it alongside the function guidance hooks. Activation requires separate worker/state proof."
      }
    },
    {
      "id": "native-stop",
      "event": "Stop",
      "providers": [
        "codex"
      ],
      "entrypoint": "scripts/stop.py",
      "invocation": {
        "kind": "python-script",
        "args": [],
        "output": "ignore"
      },
      "timeout_seconds": 10,
      "failure_policy": "continue",
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing capture and detached upload; native SessionStart also emits guidance, so never select it alongside the function guidance hooks. Activation requires separate worker/state proof."
      }
    }
  ],
  "skills": [
    {
      "path": "skills/search-coding-sessions",
      "providers": [
        "codex",
        "claude"
      ]
    }
  ],
  "commands": [],
  "dependencies": [
    {
      "kind": "executable",
      "name": "git"
    },
    {
      "kind": "mcp",
      "name": "cosmos",
      "providers": [
        "codex",
        "claude"
      ]
    }
  ],
  "state": [
    {
      "id": "logger-state",
      "purpose": "Original Codex session-logging queue, checkpoints and preferences; keep original provider-home path before enabling capture.",
      "rollback_compatible": true
    },
    {
      "id": "forum-feedback",
      "purpose": "Existing shared Forum guidance debounce directory.",
      "rollback_compatible": true
    }
  ],
  "environment": {
    "CODEX_SESSION_LOG_STATE_DIR": {
      "state": "logger-state"
    },
    "E3_COLLECTIVE_HOOK_STATE_DIR": {
      "state": "forum-feedback"
    }
  }
}
